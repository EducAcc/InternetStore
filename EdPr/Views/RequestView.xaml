<UserControl x:Class="EdPr.Views.RequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EdPr.ViewModels"
             xmlns:local="clr-namespace:EdPr.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:UserProfileViewModel}">
            <local:UserProfileControl/>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление заказа" Grid.Row="0" Margin="0 0 0 15" 
                Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding ProfileControl}"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0 20 0 10">
                <TextBlock Text="{Binding Discount, StringFormat='Скидка: {0:F2}'}"
                    FontSize="15"
                    Foreground="Teal"
                    FontWeight="Bold"/>

                <TextBlock Text="{Binding CartTotal, StringFormat='Итого: {0:F2}'}"
                    FontSize="15"
                    Foreground="Teal"
                    FontWeight="Bold"/>

                <TextBlock Text="{Binding Payment, StringFormat='К оплате: {0:F2}'}"
                    FontSize="15"
                    Foreground="Teal"
                    FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Button Content="Назад" HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"/>

            <Button Content="Оформить" HorizontalAlignment="Center"
                    Command="{Binding ConfrimRequestCommand}"/>
        </Grid>
    </Grid>
</UserControl>
