<UserControl x:Class="EdPr.Views.UserProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EdPr.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="400">

    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="BoolToVis"
        TrueValue="Visible"
        FalseValue="Collapsed"/>

        <materialDesign:BooleanToVisibilityConverter x:Key="InvBoolToVis"
        TrueValue="Collapsed"
        FalseValue="Visible"/>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Основная информация">
            <Grid Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Margin="0 10" Width="130" Height="120" 
                    HorizontalAlignment="Left" Source="{Binding Photo}" Stretch="UniformToFill"
                    Visibility="{Binding IsRequestMode, Converter={StaticResource InvBoolToVis}}"/>

                <Button Content="Выбрать фото" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" 
                    Command="{Binding UploadPhotoCommand}"
                    Visibility="{Binding IsRequestMode, Converter={StaticResource InvBoolToVis}}"/>

                <StackPanel Grid.Column="0" Grid.Row="1">
                    <Label Content="Фамилия"/>
                    <TextBox Text="{Binding User.Surname}"/>
                    <Label Content="Имя"/>
                    <TextBox Text="{Binding User.Name}"/>
                    <Label Content="Отчество"/>
                    <TextBox Text="{Binding User.Patronymic}"/>
                    <StackPanel Visibility="{Binding IsRequestMode, Converter={StaticResource InvBoolToVis}}">
                        <Label Content="Паспорт"/>
                        <TextBox Text="{Binding User.Passport}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="1">
                    <Label Content="Почта"/>
                    <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel
                        Visibility="{Binding IsRequestMode, Converter={StaticResource InvBoolToVis}}">
                        <Label Content="Логин"/>
                        <TextBox Text="{Binding User.Login, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Пароль"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Label Content="Телефон"/>
                    <TextBox Text="{Binding User.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Доп информация">
            <Grid Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel
                        Visibility="{Binding IsRequestMode, Converter={StaticResource InvBoolToVis}}">
                        <Label Content="День рождения"/>
                        <DatePicker SelectedDate="{Binding User.Birthday}"/>
                        <Label Content="Гендер"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="М" IsChecked="{Binding IsMale}" GroupName="GenderRadio"/>
                            <RadioButton Content="Ж" IsChecked="{Binding IsFemale}" GroupName="GenderRadio" Margin="10 0 0 0"/>
                        </StackPanel>
                    </StackPanel>
                    <Label Content="Улица"/>
                    <TextBox Text="{Binding User.Address.Street, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Дом"/>
                    <TextBox Text="{Binding User.Address.House, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Квартира"/>
                    <materialDesign:NumericUpDown Minimum="0"
                        Value="{Binding User.Address.Room, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Подъезд"/>
                    <materialDesign:NumericUpDown Minimum="0"
                        Value="{Binding User.Address.Entrance, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Этаж"/>
                    <materialDesign:NumericUpDown Minimum="0"
                        Value="{Binding User.Address.Floor, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
    
</UserControl>
